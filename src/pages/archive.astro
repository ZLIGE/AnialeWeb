---
/**
 * 文章归档页：按年份分组的时间线视图，展示全部非草稿文章。
 * 与首页列表（置顶优先）不同，这里严格按发布时间倒序——
 * 找旧文章比翻页快。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import type { Post } from '../utils/posts';
import { categorySlug } from '../utils/posts';

// 归档用纯时间序（不置顶浮动），草稿不出现
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

// 按年分组（posts 已倒序，年份自然降序）
const byYear = new Map<number, Post[]>();
for (const p of posts) {
  const y = p.data.published.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const md = (d: Date) =>
  `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="归档" description="全部文章的时间线归档" hero>
  <Fragment slot="hero">
    <PageBanner title="归档" sub={`共 ${posts.length} 篇文章 · ${years.length} 个年份`} />
  </Fragment>
  <div class="flex flex-col gap-5">
    <h1 class="page-heading card px-5 py-3.5 text-lg font-bold">
      ✧ 时间线
      <span class="ml-1.5 text-sm font-normal text-muted"
        >（{posts.length} 篇）</span
      >
    </h1>

    <!-- 年份锚点 -->
    <nav class="card flex flex-wrap items-center gap-2 px-5 py-3" aria-label="年份跳转">
      {
        years.map((y) => (
          <a
            href={`#year-${y}`}
            class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary transition-colors hover:bg-primary hover:text-white"
          >
            {y} 年 · {byYear.get(y)!.length}
          </a>
        ))
      }
    </nav>

    {
      years.map((y) => (
        <section class="card p-6" id={`year-${y}`}>
          <h2 class="flex items-baseline gap-2 text-xl font-bold">
            {y}
            <span class="text-xs font-normal text-muted">
              （{byYear.get(y)!.length} 篇）
            </span>
          </h2>
          <ul class="mt-3 flex flex-col">
            {byYear.get(y)!.map((p) => (
              <li class="group flex items-center gap-3 border-b border-line py-2.5 last:border-none sm:gap-4">
                <time
                  datetime={p.data.published.toISOString().slice(0, 10)}
                  class="w-11 shrink-0 font-mono text-xs tabular-nums text-muted"
                >
                  {md(p.data.published)}
                </time>
                <a
                  href={`/posts/${p.id}/`}
                  class="min-w-0 flex-1 truncate text-sm font-medium transition-colors group-hover:text-primary"
                >
                  {p.data.title}
                </a>
                {p.data.password && (
                  <Icon name="lock" class="size-3.5 shrink-0 text-muted" />
                )}
                <a
                  href={`/categories/${categorySlug(p.data.category)}`}
                  class="hidden shrink-0 rounded-full bg-primary/12 px-2 py-0.5 text-[10px] font-medium text-primary sm:inline-block"
                >
                  {p.data.category}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
