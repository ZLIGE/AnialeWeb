---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

// 数据来自 src/data/friends.yaml（PagesCMS 后台可编辑），按 order 排序
const friendsEntry = (await getCollection('friends'))[0];
const friends = (friendsEntry?.data.items ?? []).slice().sort((a, b) => a.order - b.order);
const closedCount = friends.filter((f) => f.status === 'closed').length;

/** 友链占位头像：取名字首字符 + 渐变底 */
const initialOf = (name: string) => [...name][0] ?? '❀';
---

<BaseLayout title="友情链接" description="朋友们的小星球" hero>
  <Fragment slot="hero">
    <PageBanner
      title="友情链接"
      sub={closedCount > 0
        ? `${friends.length} 位朋友 · ${closedCount} 颗星球已熄灭`
        : `${friends.length} 位朋友`}
    />
  </Fragment>
  <div class="flex flex-col gap-5">
    <h1 class="page-heading card px-5 py-3.5 text-lg font-bold">
      ✧ 友情链接
      <span class="ml-1.5 text-sm font-normal text-muted"
        >（{friends.length - closedCount} 颗星球
        {closedCount > 0 && ` · ${closedCount} 颗已熄灭`}）</span
      >
    </h1>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        friends.map((f) => {
          // 已关闭的友链：置灰、不可点击，保留位置作纪念
          const closed = f.status === 'closed';
          const inner = (
            <>
              {f.avatar ? (
                <img
                  src={f.avatar}
                  alt={`${f.name} 的头像`}
                  class:list={[
                    'size-14 shrink-0 rounded-2xl border border-line object-cover',
                    closed && 'grayscale',
                  ]}
                  loading="lazy"
                />
              ) : (
                <span
                  class:list={[
                    'text-gradient flex size-14 shrink-0 items-center justify-center rounded-2xl bg-primary/12 text-2xl font-bold',
                    closed && 'grayscale opacity-60',
                  ]}
                >
                  {initialOf(f.name)}
                </span>
              )}
              <span class="min-w-0 flex-1">
                <span class="flex items-center gap-1 font-bold transition-colors group-hover:text-primary">
                  {f.name}
                  {closed ? (
                    <span class="inline-flex items-center gap-1 rounded-full bg-black/8 px-2 py-0.5 text-[10px] font-medium text-muted dark:bg-white/10">
                      已熄灭
                    </span>
                  ) : (
                    <Icon
                      name="external"
                      class="size-3.5 text-muted opacity-0 transition-opacity group-hover:opacity-100"
                    />
                  )}
                </span>
                <span class="mt-0.5 block truncate text-sm text-muted">
                  {closed ? `（原 ${f.description}）` : f.description}
                </span>
              </span>
            </>
          );
          return closed ? (
            <div class="card flex items-center gap-4 p-5 opacity-60">{inner}</div>
          ) : (
            <a
              href={f.link}
              target="_blank"
              rel="noopener noreferrer"
              class="card lift group flex items-center gap-4 p-5"
            >
              {inner}
            </a>
          );
        })
      }
    </div>

    <section class="card p-6">
      <h2 class="font-bold">🙋 想交换友链？</h2>
      <div class="prose-anime mt-3 text-sm">
        <p>
          欢迎通过邮箱 <code>hi@example.com</code> 或任意渠道联系我，附上你的
          <strong>站点名称、头像、链接和一句话简介</strong>即可。
          只要站点是认真维护的、内容不违规，都会互相添加～
        </p>
        <p>本站信息（可直接复制）：</p>
        <ul>
          <li>名称：{siteConfig.title}</li>
          <li>简介：{siteConfig.subtitle}</li>
          <li>头像：{siteConfig.avatar}</li>
        </ul>
        <p class="mt-3 flex flex-wrap items-center gap-2">
          <button
            type="button"
            class="flex items-center gap-1.5 rounded-full bg-primary px-4 py-1.5 text-xs font-medium text-white transition-colors hover:bg-primary-deep"
            data-copy-friend-yaml
            data-yaml={`  - order: 99\n    name: ${siteConfig.title}\n    link: （部署后填正式域名）\n    avatar: ${siteConfig.avatar}\n    description: ${siteConfig.subtitle}`}
          >
            <Icon name="link" class="size-3.5" />
            一键复制本站信息
          </button>
          <span class="text-xs text-muted">粘进邮件正文或你站点的友链数据即可</span>
        </p>
      </div>
    </section>

    <section class="card p-6">
      <h2 class="font-bold">🌱 也可以直接提 PR</h2>
      <div class="prose-anime mt-3 text-sm">
        <p>
          本站友链数据在 GitHub 仓库的
          <code>src/data/friends.yaml</code>，Fork
          <a
            href="https://github.com/ZLIGE/AnialeWeb"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary hover:underline">ZLIGE/AnialeWeb</a
          >
          后在文件末尾追加一段（order 顺延），提 PR 即可：
        </p>
        <pre><code class="language-yaml">  - order: 99
    name: 你的站点名
    link: https://your.site
    avatar: https://your.site/avatar.png
    description: 一句话简介</code></pre>
        <p class="text-xs text-muted">
          头像可不填（自动用首字母占位）；合并后下一次构建即生效。
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  // 一键复制本站友链信息（YAML 片段，对方站点可直接粘贴使用）
  (function () {
    var btn = document.querySelector('[data-copy-friend-yaml]');
    if (!btn || btn.dataset.copyBound) return;
    btn.dataset.copyBound = '1';
    btn.addEventListener('click', function () {
      var yaml = btn.getAttribute('data-yaml') || '';
      if (!yaml || !navigator.clipboard || !navigator.clipboard.writeText) return;
      navigator.clipboard.writeText(yaml).then(function () {
        btn.textContent = '✓ 已复制';
        setTimeout(function () {
          btn.textContent = '一键复制本站信息';
        }, 2000);
      });
    });
  })();
</script>
