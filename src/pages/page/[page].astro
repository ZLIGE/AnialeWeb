---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getSortedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const POSTS_PER_PAGE = 8;
  const posts = await getSortedPosts();
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: {
      posts: posts.slice((i + 1) * POSTS_PER_PAGE, (i + 2) * POSTS_PER_PAGE),
      current: i + 2,
      total: totalPages,
    },
  }));
}

const { posts, current, total } = Astro.props;
---

<BaseLayout title={`第 ${current} 页`}>
  <div class="flex flex-col gap-5">
    <h1 class="card px-5 py-3.5 text-lg font-bold">
      ✧ 最近的文章
      <span class="ml-1.5 text-sm font-normal text-muted"
        >（第 {current} 页 / 共 {total} 页）</span
      >
    </h1>
    {posts.map((post) => <PostCard post={post} />)}
    <Pagination current={current} total={total} />
  </div>
</BaseLayout>
