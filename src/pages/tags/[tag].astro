---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, tagSlug } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  // params 用原始中文，Astro 会自动处理 URL 编码（链接处用 tagSlug() 编码）
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签「${tag}」`} description={`标签「${tag}」下的所有文章`}>
  <div class="flex flex-col gap-5">
    <h1 class="card px-5 py-3.5 text-lg font-bold">
      ✧ 标签「<span class="text-gradient">{tag}</span>」
      <span class="ml-1.5 text-sm font-normal text-muted"
        >（{posts.length} 篇）</span
      >
    </h1>
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
