---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedPosts, getAllTags, tagSlug } from '../../utils/posts';

const posts = await getSortedPosts();
const tags = getAllTags(posts);
const max = Math.max(...tags.map(([, n]) => n), 1);
---

<BaseLayout title="标签" description="全部文章标签">
  <div class="flex flex-col gap-5">
    <h1 class="card px-5 py-3.5 text-lg font-bold">
      ✧ 标签
      <span class="ml-1.5 text-sm font-normal text-muted"
        >（共 {tags.length} 个）</span
      >
    </h1>

    <div class="card flex flex-wrap items-baseline gap-x-5 gap-y-3 p-6">
      {
        tags.map(([tag, count]) => (
          <a
            href={`/tags/${tagSlug(tag)}`}
            class="text-gradient font-bold transition-transform hover:scale-110"
            style={`font-size:${1 + (count / max) * 0.9}rem`}
          >
            {tag}
            <sup class="text-xs opacity-70">{count}</sup>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
