---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="作品集" description="我做过的一些项目与作品">
  <div class="flex flex-col gap-5">
    <h1 class="card px-5 py-3.5 text-lg font-bold">
      ✧ 作品集
      <span class="ml-1.5 text-sm font-normal text-muted"
        >（{projects.length} 件）</span
      >
    </h1>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        projects.map((p) => (
          <section class="card lift flex flex-col p-5 sm:p-6">
            <div class="flex items-center gap-3">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-primary/12 text-2xl">
                {p.icon}
              </span>
              <h2 class="text-lg font-bold">{p.name}</h2>
            </div>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
              {p.description}
            </p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {p.tags.map((t) => (
                <span class="chip">#{t}</span>
              ))}
            </div>
            {(p.link || p.repo) && (
              <div class="mt-4 flex gap-2">
                {p.link && (
                  <a
                    href={p.link}
                    class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-3.5 py-1.5 text-xs font-bold text-white transition-colors hover:bg-primary-deep"
                    target={p.link.startsWith('/') ? undefined : '_blank'}
                    rel="noopener noreferrer"
                  >
                    <Icon name="external" class="size-3.5" /> 访问
                  </a>
                )}
                {p.repo && (
                  <a
                    href={p.repo}
                    class="inline-flex items-center gap-1.5 rounded-xl border border-line px-3.5 py-1.5 text-xs font-bold text-muted transition-colors hover:border-primary hover:text-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="github" class="size-3.5" /> 源码
                  </a>
                )}
              </div>
            )}
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
