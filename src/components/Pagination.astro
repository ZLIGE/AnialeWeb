---
/**
 * 分页条：上一页 / 页码 / 下一页
 */
import Icon from './Icon.astro';

interface Props {
  current: number;
  total: number;
  /** 根路径，如 ''（首页）或 '/tags/前端' */
  basePath?: string;
}

const { current, total, basePath = '' } = Astro.props;
const pageHref = (n: number) =>
  n === 1 ? `${basePath}/` : `${basePath}/page/${n}`;
---

{
  total > 1 && (
    <nav class="mt-6 flex items-center justify-center gap-1.5" aria-label="分页">
      {current > 1 && (
        <a
          href={pageHref(current - 1)}
          class="card flex size-9 items-center justify-center text-muted hover:text-primary"
          aria-label="上一页"
        >
          <Icon name="chevron-left" class="size-4" />
        </a>
      )}
      {Array.from({ length: total }, (_, i) => i + 1).map((n) =>
        n === current ? (
          <span class="flex size-9 items-center justify-center rounded-xl bg-primary font-bold text-white shadow-card">
            {n}
          </span>
        ) : (
          <a
            href={pageHref(n)}
            class="card flex size-9 items-center justify-center text-muted transition-colors hover:text-primary"
          >
            {n}
          </a>
        )
      )}
      {current < total && (
        <a
          href={pageHref(current + 1)}
          class="card flex size-9 items-center justify-center text-muted hover:text-primary"
          aria-label="下一页"
        >
          <Icon name="chevron-right" class="size-4" />
        </a>
      )}
    </nav>
  )
}
