---
/**
 * 首页 Banner：二次元梦幻夜景插图 + 站名/签名（图片可在 src/config.ts 更换）
 */
import { siteConfig } from '../config';

const { banner, title, subtitle } = siteConfig;
---

<section class="card relative overflow-hidden">
  <img
    src={banner.image}
    alt="梦幻星空插画"
    class="h-60 w-full object-cover sm:h-72 lg:h-80"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 bg-linear-to-t from-black/60 via-black/20 to-transparent"
    style={`opacity:${Math.min(banner.overlay + 0.35, 1)}`}
  >
  </div>
  <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
    <h1
      class="text-3xl font-bold text-white drop-shadow-[0_2px_8px_rgba(80,40,140,0.6)] sm:text-4xl"
    >
      {title}
    </h1>
    <p class="mt-2 text-sm text-white/85 sm:text-base">{subtitle}</p>
  </div>
  <div
    class="absolute right-5 top-5 rounded-full bg-white/15 px-3 py-1 text-xs text-white backdrop-blur-sm"
  >
    ✧ 梦幻紫的小宇宙 ✧
  </div>
</section>
