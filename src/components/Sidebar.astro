---
/**
 * 桌面端左侧栏（lg 以上显示）：资料卡 + 公告卡 + 分类卡 + 标签卡。
 * 导航/搜索/调色板/明暗切换已统一收纳进顶部功能栏（Navbar），此处不再重复。
 */
import { siteConfig } from '../config';
import {
  categorySlug,
  getAllCategories,
  getAllTags,
  getSortedPosts,
  tagSlug,
} from '../utils/posts';
import Icon from './Icon.astro';
import Announcement from './Announcement.astro';

const { subtitle, author, avatar, social } = siteConfig;

const posts = await getSortedPosts();
const tags = getAllTags(posts).slice(0, 12);
const cats = getAllCategories(posts).slice(0, 6);
---

<aside
  class="sticky top-20 hidden w-60 shrink-0 flex-col gap-5 self-start lg:flex 2xl:w-64"
>
  <!-- 个人资料卡（Shirone 风格：头像大图置顶 + 居中信息） -->
  <section class="card overflow-hidden">
    <img
      src={avatar}
      alt={`${author} 的头像`}
      class="aspect-square w-full object-cover"
      width="288"
      height="288"
    />
    <div class="flex flex-col items-center px-5 pb-5 pt-4">
      <h2 class="text-lg font-bold">{author}</h2>
      <span class="my-2.5 h-[3px] w-9 rounded-full bg-primary/50"></span>
      <p class="text-center text-sm leading-relaxed text-muted">{subtitle}</p>
      <div class="mt-3 flex items-center gap-1.5">
        {
          social.map((s) => (
            <a
              href={s.url}
              target={s.url.startsWith('/') ? undefined : '_blank'}
              rel="noopener noreferrer"
              aria-label={s.name}
              title={s.name}
              class="flex size-8 items-center justify-center rounded-full text-muted transition-all hover:-translate-y-0.5 hover:bg-primary/15 hover:text-primary"
            >
              <Icon name={s.icon} class="size-4.5" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 公告卡 -->
  <Announcement />

  <!-- 分类卡 -->
  <section class="card p-5">
    <div class="mb-3 flex items-center justify-between">
      <h3 class="text-sm font-bold">✧ 分类</h3>
      <a href="/categories" class="text-xs text-muted hover:text-primary"
        >全部 →</a
      >
    </div>
    <ul class="flex flex-col gap-0.5">
      {
        cats.map(([c, count]) => (
          <li>
            <a
              href={`/categories/${categorySlug(c)}`}
              class="group flex items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm text-muted transition-colors hover:bg-primary/10 hover:text-primary"
            >
              <Icon name="folder" class="size-4 shrink-0" />
              <span class="flex-1 truncate">{c}</span>
              <span class="text-xs opacity-60">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 标签卡 -->
  <section class="card p-5">
    <div class="mb-3 flex items-center justify-between">
      <h3 class="text-sm font-bold">✧ 标签云</h3>
      <a href="/tags" class="text-xs text-muted hover:text-primary"
        >全部 →</a
      >
    </div>
    <div class="flex flex-wrap gap-1.5">
      {
        tags.map(([tag, count]) => (
          <a href={`/tags/${tagSlug(tag)}`} class="chip">
            {tag}
            <span class="opacity-60">{count}</span>
          </a>
        ))
      }
    </div>
  </section>
</aside>
