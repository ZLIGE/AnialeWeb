---
/**
 * 顶部功能栏（参考 shirone.mysqil.com）：站点名 + 图标导航 + 搜索/调色板/主题。
 * 页面顶部时透明，滚动后变为毛玻璃卡片；移动端（lg 以下）收纳为汉堡抽屉。
 * 事件全部使用委托，视图过渡换页后依然生效。
 */
import { siteConfig } from '../config';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import PaletteSwitcher from './PaletteSwitcher.astro';

const { title, nav } = siteConfig;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (link: string) =>
  link === '/' ? current === '/' : current.startsWith(link);
---

<header id="site-navbar" class="fixed inset-x-0 top-0 z-50">
  <div
    class="navbar-row mx-auto flex h-16 max-w-[90rem] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
  >
    <!-- 站点标识：竖条装饰 + 站名 -->
    <a href="/" class="navbar-brand flex shrink-0 items-center gap-2 text-lg font-bold tracking-wide">
      <span class="h-5 w-1 rounded-full bg-linear-180 from-primary to-accent"></span>
      <span class="text-gradient">{title}</span>
    </a>

    <!-- 桌面图标导航 -->
    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.link}
            class:list={[
              'relative flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.link)
                ? 'text-primary'
                : 'text-muted hover:bg-primary/10 hover:text-primary',
            ]}
            aria-current={isActive(item.link) ? 'page' : undefined}
          >
            <Icon name={item.icon} class="size-4" />
            {item.text}
            {isActive(item.link) && (
              <span class="absolute inset-x-3 -bottom-[9px] h-0.5 rounded-full bg-primary" />
            )}
          </a>
        ))
      }
    </nav>

    <!-- 右侧功能区：搜索 / 调色板 / 明暗切换 / 移动端菜单 -->
    <div class="flex shrink-0 items-center gap-1">
      <button
        class="search-trigger hidden size-9 items-center justify-center rounded-full text-muted transition-colors hover:bg-primary/10 hover:text-primary sm:flex"
        aria-label="搜索文章"
      >
        <Icon name="search" class="size-5" />
      </button>
      <PaletteSwitcher direction="down" />
      <ThemeToggle />
      <button
        id="menu-open"
        class="flex size-9 items-center justify-center rounded-full text-muted transition-colors hover:bg-primary/10 hover:text-primary lg:hidden"
        aria-label="打开菜单"
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>
</header>

<!-- 抽屉菜单（移动端） -->
<div id="menu-drawer" class="fixed inset-0 z-[60] hidden lg:hidden">
  <div
    id="menu-mask"
    class="absolute inset-0 bg-black/45 backdrop-blur-sm transition-opacity"
  >
  </div>
  <nav
    class="card card-glass absolute right-3 top-3 w-64 p-3 shadow-lift"
    aria-label="站点导航"
  >
    <div class="mb-2 flex items-center justify-between px-2 pt-1">
      <span class="text-sm font-bold text-muted">✧ 导航</span>
      <button
        id="menu-close"
        class="flex size-8 items-center justify-center rounded-full text-muted hover:bg-primary/10 hover:text-primary"
        aria-label="关闭菜单"
      >
        <Icon name="x" class="size-4" />
      </button>
    </div>
    <ul class="flex flex-col gap-1">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.link}
              class:list={[
                'flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors',
                isActive(item.link)
                  ? 'bg-primary/15 text-primary'
                  : 'text-muted hover:bg-primary/10 hover:text-primary',
              ]}
            >
              <Icon name={item.icon} class="size-4.5" />
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  /* 导航栏：始终为悬浮圆角毛玻璃卡片（参考 Mizuki 样式）——
     从页面顶部就与壁纸明确区分，不存在透明→实底的切换瞬间
     （此前滚动时短暂无法分辨的根源）。
     不使用 backdrop-filter：滚动跨越阈值时它会被创建/销毁，
     Chromium 合成新层的瞬间会在页面顶部闪出一条白色发丝线 */
  #site-navbar {
    top: 0.75rem;
    left: 1rem;
    right: 1rem;
    border-radius: 1rem;
    border: 1px solid var(--line);
    background-color: color-mix(in oklch, var(--card) 96%, transparent);
    box-shadow: var(--shadow-nav);
  }
</style>
