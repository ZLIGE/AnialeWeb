---
/**
 * 壁纸背景层（首页横幅与文章横幅共享）：
 * transition:persist 让这层 DOM——已加载的 5 张壁纸、遮罩、波浪动画相位——
 * 在换页时原样跨页保留：壁纸不重载、不闪烁；标题层独立淡出/淡入。
 */
import { siteConfig } from '../config';

const { hero } = siteConfig;
const images = hero.images;
---

<div class="hero-backdrop absolute inset-0" transition:persist="hero-backdrop">
  {
    images.map((src, i) => (
      <img
        src={src}
        alt=""
        class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-[1400ms] ease-in-out motion-reduce:transition-none"
        data-hero-img={i}
        loading="eager"
        fetchpriority={i === 0 ? 'high' : 'auto'}
        draggable="false"
      />
    ))
  }
  <div
    class="absolute inset-0 bg-linear-to-t from-black/60 via-black/20 to-black/25"
    style={`opacity:${hero.overlay + 0.1}`}
  >
  </div>

  <!-- 层叠波浪边界（面板「水波纹动画」off 时移除） -->
  <div class="hero-waves" aria-hidden="true">
    <svg class="wave wave-back" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path
        d="M0,66 C240,108 480,26 720,66 C960,108 1200,26 1440,66 C1680,108 1920,26 2160,66 C2400,108 2640,26 2880,66 L2880,121 L0,121 Z"
      ></path>
    </svg>
    <svg class="wave wave-mid" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path
        d="M0,52 C240,94 480,14 720,52 C960,94 1200,14 1440,52 C1680,94 1920,14 2160,52 C2400,94 2640,14 2880,52 L2880,121 L0,121 Z"
      ></path>
    </svg>
    <svg class="wave wave-front" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path
        d="M0,34 C240,72 480,4 720,34 C960,72 1200,4 1440,34 C1680,72 1920,4 2160,34 C2400,72 2640,4 2880,34 L2880,121 L0,121 Z"
      ></path>
    </svg>
  </div>
</div>

<style>
  /* 层叠波浪边界：三层漂移 + 纵向起伏，前层用页面底色无缝衔接；
     SVG 高度越界 10px 防起伏露底 */
  .hero-waves {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 130px;
    pointer-events: none;
  }
  .wave {
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 200%;
    height: calc(100% + 20px);
  }
  /* 波浪动效由 WAAPI 驱动（见下方脚本）：动画绑定在元素而非文档上，
     transition:persist 跨页搬移元素时相位保持连续，不会抽搐 */
  .wave-back {
    fill: rgb(255 255 255 / 0.14);
  }
  .wave-mid {
    fill: rgb(255 255 255 / 0.24);
  }
  .wave-front {
    fill: var(--bg);
    transition: fill 0.3s ease;
  }
  /* 壁纸层纯视觉：图片/遮罩/波浪不拦截任何指针交互
     （否则全屏/覆盖模式下整层会挡住调色板等浮层的操作） */
  .hero-backdrop,
  .hero-backdrop :where(img, div, svg, path) {
    pointer-events: none;
  }
  /* 面板「水波纹动画」关闭时彻底去除波浪层 */
  :global([data-hero-ripple='off']) .hero-waves {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .wave {
      animation: none;
    }
  }
</style>

<script>
  /**
   * 多层水波动效（WAAPI 驱动）：动画对象跟随元素。
   * transition:persist 跨页搬移元素时，动画的时间线还挂在旧文档上会冻结——
   * 换页后重新绑定到当前文档时间线并恢复局部时间，波浪相位连续不抽搐、不卡住。
   */
  function startWaves() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const presets: {
      keyframes: Keyframe[];
      duration: number;
      direction: PlaybackDirection;
    }[] = [
      {
        keyframes: [
          { transform: 'translate3d(0, -9px, 0)' },
          { transform: 'translate3d(-25%, 7px, 0)' },
          { transform: 'translate3d(-50%, -9px, 0)' },
        ],
        duration: 24000,
        direction: 'reverse',
      },
      {
        keyframes: [
          { transform: 'translate3d(0, 6px, 0)' },
          { transform: 'translate3d(-25%, -8px, 0)' },
          { transform: 'translate3d(-50%, 6px, 0)' },
        ],
        duration: 15000,
        direction: 'normal',
      },
      {
        keyframes: [
          { transform: 'translate3d(0, -5px, 0)' },
          { transform: 'translate3d(-25%, 5px, 0)' },
          { transform: 'translate3d(-50%, -5px, 0)' },
        ],
        duration: 10000,
        direction: 'normal',
      },
    ];
    const kinds = ['wave-back', 'wave-mid', 'wave-front'];
    document
      .querySelectorAll<HTMLElement>('.hero-waves .wave')
      .forEach((wave) => {
        const preset = presets.find((p, i) => wave.classList.contains(kinds[i]));
        if (!preset) return;
        const existing = wave
          .getAnimations()
          .filter((a): a is Animation => a instanceof Animation);
        if (existing.length > 0) {
          // 持久层跨页搬移：动画还在但时间线挂在旧文档上已冻结，
          // 重新绑定到当前文档时间线并恢复局部时间（相位连续不跳变）
          for (const anim of existing) {
            const t = anim.currentTime;
            try {
              anim.timeline = document.timeline;
              if (t !== null) anim.currentTime = t;
            } catch {
              anim.cancel();
              wave.animate(preset.keyframes, {
                duration: preset.duration,
                iterations: Infinity,
                direction: preset.direction,
                easing: 'linear',
              });
            }
          }
          return;
        }
        wave.animate(preset.keyframes, {
          duration: preset.duration,
          iterations: Infinity,
          direction: preset.direction,
          easing: 'linear',
        });
      });
  }
  startWaves();
  document.addEventListener('astro:page-load', startWaves);
  document.addEventListener('site:settings', startWaves);
</script>
