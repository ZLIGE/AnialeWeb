---
/**
 * Live2D 看板娘（l2d-widget 驱动——oh-my-live2d 官方后继，配置见 src/config.ts）。
 * - 动态 import 隔离加载：库或模型加载失败时仅打印警告，不影响站点
 * - 移动端不展示（与原 oh-my-live2d 的 mobileDisplay: false 行为一致）
 * - 按住模型画布拖动即可直接改变位置（轻点仍是互动），松手后记忆到 localStorage
 */
---

<!-- 持久宿主：看板娘的 DOM 移入这里后跨页保留，不会被换页清除 -->
<div id="l2d-host" transition:persist="l2d-widget"></div>

<style>
  /* 宿主固定为全屏透明层：看板娘（内部 fixed 定位的画布）坐标
     永远相对视口，不随页面内容高度/滚动漂移；pointer-events 穿透，
     仅模型画布本身可交互（拖动/点击） */
  #l2d-host {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
  }
  #l2d-host canvas {
    pointer-events: auto;
    cursor: grab;
  }
</style>

<script>
  import { siteConfig } from '../config';

  const POS_KEY = 'l2d-widget-drag-pos';
  /** 按下后移动超过该距离即进入拖拽（不足阈值松手 = 轻点互动） */
  const MOVE_CANCEL_PX = 8;

  const { live2d } = siteConfig;

  const clamp = (v: number, min: number, max: number) =>
    Math.min(Math.max(v, min), max);

  const readSaved = (): { left: number; top: number } | null => {
    try {
      const raw = localStorage.getItem(POS_KEY);
      if (!raw) return null;
      const p = JSON.parse(raw);
      return Number.isFinite(p?.left) && Number.isFinite(p?.top) ? p : null;
    } catch {
      return null;
    }
  };

  const save = (left: number, top: number) => {
    try {
      localStorage.setItem(POS_KEY, JSON.stringify({ left, top }));
    } catch {
      /* 隐私模式下忽略 */
    }
  };

  // 移动端不展示（与原 oh-my-live2d 的 mobileDisplay: false 行为一致）
  if (window.matchMedia('(min-width: 768px)').matches) {
    import('l2d-widget')
      .then(({ createWidget }) => {
        const host = document.getElementById('l2d-host');
        if (!host) return;
        // 记录创建前已存在的 body 子元素，用于识别看板娘生成的节点
        const known = new Set([...document.body.children]);

        createWidget({
          model: live2d.models.map(({ path, scale }) => ({ path, scale })),
          position:
            live2d.dockedPosition === 'left' ? 'bottom-left' : 'bottom-right',
          size: 400,
          primaryColor: live2d.primaryColor,
          tips: {
            typing: { param: 'PARAM_MOUTH_OPEN_Y', speed: 100 },
          },
        });

        // 组件生成的所有固定定位元素移入持久宿主（换页不被清除）
        [...document.body.children]
          .filter((el) => !known.has(el) && el !== host)
          .forEach((el) => host.appendChild(el));

        const canvas = host.querySelector('canvas');
        if (canvas) {
          setupDragging(canvas as HTMLCanvasElement);
          // 入场滑入动画在部分页面不触发（transform 卡在 520px 出场位，
          // 看板娘被推出视口外"消失"），初始化后直接归零保证始终可见；
          // sleep() 的隐藏与再次唤醒不受影响（归零只在初始化时执行一次）
          const wrapper = canvas.parentElement;
          if (wrapper) wrapper.style.transform = 'none';
        }
      })
      .catch((err) => console.warn('[Live2D] 看板娘加载失败，已自动跳过：', err));
  }

  function setupDragging(canvas: HTMLCanvasElement) {
    // 定位目标：l2d-widget 的 stage 容器（canvas 本身是 static，
    // position: fixed 的是其父元素——拖拽/恢复必须改父元素的 left/top）
    const stage = canvas.parentElement as HTMLElement;

    const restore = () => {
      const saved = readSaved();
      if (!saved) return;
      stage.style.left = `${clamp(
        saved.left,
        0,
        window.innerWidth - stage.offsetWidth
      )}px`;
      stage.style.top = `${clamp(
        saved.top,
        0,
        window.innerHeight - stage.offsetHeight
      )}px`;
      stage.style.right = 'auto';
      stage.style.bottom = 'auto';
    };

    // 恢复上次记忆的位置
    restore();

    let pressing = false;
    let dragMode = false;
    let pointerId = -1;
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startTop = 0;

    const cancelPress = () => {
      pressing = false;
      dragMode = false;
    };

    const enterDrag = () => {
      dragMode = true;
      const rect = stage.getBoundingClientRect();
      startLeft = rect.left;
      startTop = rect.top;
      stage.style.left = `${rect.left}px`;
      stage.style.top = `${rect.top}px`;
      stage.style.right = 'auto';
      stage.style.bottom = 'auto';
      stage.style.cursor = 'grabbing';
      document.body.style.userSelect = 'none';
      try {
        canvas.setPointerCapture(pointerId);
      } catch {
        /* 合成事件或指针已释放时忽略 */
      }
    };

    canvas.addEventListener('pointerdown', (e: PointerEvent) => {
      pressing = true;
      dragMode = false;
      pointerId = e.pointerId;
      startX = e.clientX;
      startY = e.clientY;
    });

    window.addEventListener(
      'pointermove',
      (e: PointerEvent) => {
        if (!pressing) return;
        if (!dragMode) {
          // 直接拖拽：按下后移动超过阈值即开始拖动（不足阈值松手 = 轻点互动）
          if (
            Math.hypot(e.clientX - startX, e.clientY - startY) > MOVE_CANCEL_PX
          )
            enterDrag();
          return;
        }
        e.preventDefault();
        stage.style.left = `${clamp(
          startLeft + (e.clientX - startX),
          0,
          window.innerWidth - stage.offsetWidth
        )}px`;
        stage.style.top = `${clamp(
          startTop + (e.clientY - startY),
          0,
          window.innerHeight - stage.offsetHeight
        )}px`;
      },
      { passive: false }
    );

    window.addEventListener(
      'pointerup',
      (e) => {
        if (!pressing) return;
        const wasDrag = dragMode;
        cancelPress();
        stage.style.cursor = '';
        document.body.style.userSelect = '';
        if (!wasDrag) return;
        // 拦截拖动结束事件，避免模型把这次按压当成触摸互动
        e.preventDefault();
        e.stopPropagation();
        save(
          parseFloat(stage.style.left) || 0,
          parseFloat(stage.style.top) || 0
        );
      },
      true
    );

    window.addEventListener('pointercancel', cancelPress);
  }
</script>
