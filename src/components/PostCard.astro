---
/**
 * 文章卡片：左侧文字（分类/标题/摘要/日期标签）+ 右侧封面缩略图 + 进入箭头。
 * 整卡可点击：采用「拉伸链接」模式（绝对定位覆盖层），
 * 避免锚点嵌套——HTML 解析器会拆碎嵌套的 <a>，破坏布局与点击。
 * 右侧箭头为纯装饰（pointer-events-none），点击穿透到拉伸链接进入文章。
 */
import Icon from './Icon.astro';
import { categorySlug, formatDate, tagSlug, type Post } from '../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const {
  title,
  description,
  published,
  tags,
  category,
  image,
  pinned,
  password,
} = post.data;
---

<article class="card lift group relative overflow-hidden">
  <!-- 拉伸链接：覆盖整卡，点击任意空白处进入文章。
       z-10：悬停时封面图的 scale 变换会创建层叠上下文抬升图片，
       链接必须恒定压在其上，否则悬停后点击图片区域会失效 -->
  <div class="post-card-inner flex items-stretch gap-4">
    <div
      class:list={[
        'flex min-w-0 flex-1 flex-col p-5 sm:p-6',
        !image && 'post-card-text-plain',
      ]}
    >
      <div
        class="flex flex-wrap items-center gap-2 gap-y-1.5 text-xs text-muted"
      >
        {
          pinned && (
            <span class="relative z-10 inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full bg-accent/15 px-2 py-0.5 font-medium text-accent">
              <Icon name="pin" class="size-3" />
              置顶
            </span>
          )
        }
        {
          password && (
            <span class="relative z-10 inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full bg-primary/12 px-2 py-0.5 text-primary">
              <Icon name="lock" class="size-3" />
              已加密
            </span>
          )
        }
        <a
          href={`/categories/${categorySlug(category)}`}
          class="relative z-10 shrink-0 whitespace-nowrap rounded-full bg-primary/12 px-2.5 py-0.5 font-medium text-primary transition-colors hover:bg-primary hover:text-white"
        >
          {category}
        </a>
        <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap">
          <Icon name="calendar" class="size-3.5" />
          {formatDate(published)}
        </span>
      </div>
      <h2
        class="mt-2.5 line-clamp-2 text-lg font-bold sm:text-xl"
      >
        <a
          href={`/posts/${post.id}`}
          class="group/title transition-colors hover:text-primary"
        >
          {title}
          <Icon
            name="chevron-right"
            class="inline-block size-4 -translate-x-1 opacity-0 transition-all duration-300 group-hover/title:translate-x-0.5 group-hover/title:opacity-100"
          />
        </a>
      </h2>
      <p class="mt-2 line-clamp-2 text-sm text-muted">
        {description || '（这篇主人偷懒没有写摘要喵～）'}
      </p>
      {
        tags.length > 0 && (
          <div class="mt-auto flex flex-wrap gap-1.5 pt-3">
            {tags.map((t) => (
              <span class="chip">#{t}</span>
            ))}
          </div>
        )
      }
    </div>
    {
      image && (
        <a
          href={`/posts/${post.id}`}
          aria-label={title}
          class="post-card-cover relative block hidden w-44 shrink-0 self-stretch overflow-hidden sm:block lg:w-52"
        >
          <img
            src={image}
            alt={`《${title}》封面`}
            class="size-full object-cover transition-all duration-500 group-hover:scale-105 group-hover:brightness-75"
            loading="lazy"
          />
        </a>
      )
    }
  </div>

  <!-- 右侧进入箭头：有封面时悬停卡片浮现纯箭头（纯装饰，点击由封面链接承接）；
       无封面时箭头胶囊本身是进入文章的链接 -->
    {
      image ? (
        <div class="post-card-arrow pointer-events-none absolute inset-y-0 right-0 hidden w-44 items-center justify-center sm:flex lg:w-52">
          <span class="text-white opacity-0 drop-shadow-[0_2px_6px_rgba(20,10,40,0.55)] transition-all duration-300 group-hover:scale-110 group-hover:opacity-100">
            <Icon name="chevron-right" class="size-7" />
          </span>
        </div>
      ) : (
        <div class="post-card-arrow post-card-arrow-plain absolute inset-y-0 right-0 hidden items-center pr-3 sm:flex">
          <a
            href={`/posts/${post.id}`}
            aria-label={title}
            class="post-card-arrow-capsule pointer-events-auto flex h-4/5 w-10 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-colors duration-300 group-hover:bg-primary/20"
          >
            <Icon
              name="chevron-right"
              class="size-5 transition-transform duration-300 group-hover:translate-x-0.5"
            />
          </a>
        </div>
      )
    }
</article>
