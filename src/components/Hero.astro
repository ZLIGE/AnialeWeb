---
/**
 * 首页 Hero：顶部全宽大图轮播（Shirone 风格）。
 * - 打开网站时随机从一张图开始，之后按 hero.interval 自动轮播
 * - 指示点可手动切换；调色板「随机换一张」按钮触发 hero:shuffle 事件
 * - 底部渐变遮罩 + 站点标题（横幅标题可经面板关闭）
 * - 可选水波纹动画：Canvas 双色椭圆环扩散，鼠标划过与自动涟漪
 * - 展示模式（横幅/全屏/覆盖/隐藏）由 <html data-hero-mode> 控制，见 global.css
 */
import { siteConfig } from '../config';
import Icon from './Icon.astro';

const { hero, title, subtitle, social } = siteConfig;
const images = hero.images;
const taglines = hero.taglines ?? [];
---

<section
  id="hero"
  class="relative h-[62vh] max-h-[640px] min-h-[420px] w-full overflow-hidden bg-linear-160 from-[oklch(0.3_0.08_295)] to-[oklch(0.45_0.12_320)]"
>
  {
    images.map((src, i) => (
      <img
        src={src}
        alt={`站点背景 ${i + 1}`}
        class:list={[
          'absolute inset-0 size-full object-cover transition-opacity duration-[1400ms] ease-in-out motion-reduce:transition-none',
          'opacity-0',
        ]}
        data-hero-img={i}
        loading={i === 0 ? 'eager' : 'auto'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        draggable="false"
      />
    ))
  }
  <div
    class="absolute inset-0 bg-linear-to-t from-black/60 via-black/20 to-black/25"
    style={`opacity:${hero.overlay + 0.1}`}
  >
  </div>

  <!-- 水波纹动画画布（开关由 <html data-hero-ripple> 控制） -->
  <canvas
    data-hero-ripple
    class="pointer-events-none absolute inset-0 size-full"
    aria-hidden="true"
  >
  </canvas>

  <!-- 底部渐变过渡（独立于标题，保证与内容衔接的可读性） -->
  <div class="absolute inset-x-0 bottom-0 h-36 bg-linear-to-t from-black/50 to-transparent" />

  <!-- 标题（居中布局，横幅选项中可关闭） -->
  <div
    data-hero-caption
    data-taglines={JSON.stringify(taglines)}
    class="absolute inset-0 flex flex-col items-center justify-center gap-4 px-6 pb-10 text-center"
  >
    <h1
      class="text-4xl font-bold text-white drop-shadow-[0_2px_14px_rgba(10,5,30,0.75)] sm:text-6xl lg:text-7xl"
    >
      {title}
    </h1>
    <p class="min-h-[1.6em] text-lg text-white/90 drop-shadow sm:text-xl">
      {taglines.length > 0 ? <span data-hero-type /> : subtitle}
      {taglines.length > 0 && (
        <span class="type-caret" data-hero-caret aria-hidden="true" />
      )}
    </p>
    <div class="mt-2 flex items-center gap-2.5">
      {
        social.map((s, i) => (
          <a
            href={s.url}
            target={s.url.startsWith('/') ? undefined : '_blank'}
            rel="noopener noreferrer"
            aria-label={s.name}
            title={s.name}
            class:list={[
              'flex items-center bg-white/20 text-white backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:bg-white/35',
              i === 0
                ? 'gap-1.5 rounded-full px-4 py-2 text-sm font-medium'
                : 'size-10 justify-center rounded-full',
            ]}
          >
            <Icon name={s.icon} class="size-4.5" />
            {i === 0 && <span>{s.name}</span>}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* 打字机光标 */
  .type-caret {
    display: inline-block;
    width: 3px;
    height: 1.05em;
    margin-left: 3px;
    vertical-align: -0.12em;
    border-radius: 2px;
    background: currentColor;
    animation: hero-caret-blink 1.1s steps(2, start) infinite;
  }
  @keyframes hero-caret-blink {
    to {
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .type-caret {
      animation: none;
    }
  }
</style>

<!-- 随机起始 + 自动轮播 + 水波纹；data-astro-rerun 保证每次换页进入首页都重新初始化 -->
<script is:inline data-astro-rerun>
  (function () {
    var hero = document.getElementById('hero');
    if (!hero) return;
    var imgs = hero.querySelectorAll('img[data-hero-img]');
    if (imgs.length === 0) return;

    var interval = 6000;
    var current = Math.floor(Math.random() * imgs.length); // 随机起始
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var timer = 0;

    function show(n) {
      current = (n + imgs.length) % imgs.length;
      imgs.forEach(function (img, i) {
        img.style.opacity = i === current ? '1' : '0';
      });
    }

    function next() {
      show(current + 1);
    }
    function restart() {
      clearInterval(timer);
      if (!reduce) {
        timer = setInterval(function () {
          // 换页后旧 DOM 已脱离文档时自动停止
          if (!hero.isConnected) {
            clearInterval(timer);
            return;
          }
          next();
        }, interval);
      }
    }

    show(current);
    restart();

    // ── 随机换一张（调色板「壁纸」段的刷新按钮） ──────────
    function shuffle() {
      if (imgs.length < 2) return;
      var n = current;
      while (n === current) n = Math.floor(Math.random() * imgs.length);
      show(n);
      restart();
    }

    // ── 水波纹动画 ────────────────────────────────────────
    var engine = null;
    function createRipple() {
      var canvas = hero.querySelector('[data-hero-ripple]');
      if (!canvas) return null;
      var ctx = canvas.getContext('2d');
      if (!ctx) return null;
      var w = 0;
      var h = 0;
      var dpr = 1;
      var ripples = [];
      var raf = 0;
      var stopped = false;
      var lastPointer = 0;
      var lastAuto = 0;

      function resize() {
        var r = hero.getBoundingClientRect();
        if (r.width < 2 || r.height < 2) return;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = r.width;
        h = r.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
      }
      resize();
      if (window.ResizeObserver) new ResizeObserver(resize).observe(hero);

      function spawn(x, y) {
        if (ripples.length > 28) ripples.shift();
        ripples.push({ x: x, y: y, r: 3, v: 1.15 + Math.random() * 0.9, a: 0.5 });
      }

      function frame(t) {
        if (stopped) return;
        raf = requestAnimationFrame(frame);
        var rect = hero.getBoundingClientRect();
        // 滚出视口 / 页面隐藏 / 尺寸异常时跳过绘制，省电省帧
        if (rect.bottom < 0 || rect.height < 2 || document.hidden) return;
        if (t - lastAuto > 2600) {
          lastAuto = t;
          spawn(20 + Math.random() * (w - 40), 20 + Math.random() * (h - 40));
        }
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);
        ctx.globalCompositeOperation = 'lighter';
        ripples = ripples.filter(function (p) {
          return p.a > 0.03 && p.r < Math.max(w, h) * 0.6;
        });
        for (var i = 0; i < ripples.length; i++) {
          var p = ripples[i];
          p.r += p.v;
          p.a *= 0.962;
          // 暗色折射环（波谷阴影，普通合成，保证亮色图片上也可见）
          ctx.globalCompositeOperation = 'source-over';
          ctx.strokeStyle = 'rgba(15,25,60,' + (p.a * 0.35).toFixed(3) + ')';
          ctx.lineWidth = 2.4;
          ctx.beginPath();
          ctx.ellipse(p.x, p.y, p.r * 0.86, p.r * 0.36, 0, 0, Math.PI * 2);
          ctx.stroke();
          // 亮环（波峰）+ 宽柔环（波腹），加法混合发光，椭圆模拟水面透视
          ctx.globalCompositeOperation = 'lighter';
          ctx.strokeStyle = 'rgba(255,255,255,' + p.a.toFixed(3) + ')';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.ellipse(p.x, p.y, p.r, p.r * 0.42, 0, 0, Math.PI * 2);
          ctx.stroke();
          ctx.strokeStyle = 'rgba(170,205,255,' + (p.a * 0.45).toFixed(3) + ')';
          ctx.lineWidth = 3.2;
          ctx.beginPath();
          ctx.ellipse(p.x, p.y, p.r * 0.68, p.r * 0.29, 0, 0, Math.PI * 2);
          ctx.stroke();
        }
      }

      function onMove(e) {
        var rect = hero.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        if (x < 0 || y < 0 || x > rect.width || y > rect.height) return;
        var now = performance.now();
        if (now - lastPointer < 75) return;
        lastPointer = now;
        spawn(x, y);
      }

      window.addEventListener('pointermove', onMove, { passive: true });
      raf = requestAnimationFrame(frame);

      return {
        stop: function () {
          stopped = true;
          cancelAnimationFrame(raf);
          window.removeEventListener('pointermove', onMove);
          ctx.clearRect(0, 0, w, h);
        },
      };
    }

    function syncRipple() {
      var want =
        !reduce &&
        document.documentElement.getAttribute('data-hero-ripple') !== 'off';
      if (want && !engine && hero.isConnected) engine = createRipple();
      if ((!want || !hero.isConnected) && engine) {
        engine.stop();
        engine = null;
      }
    }

    // ── 打字机标语 ────────────────────────────────────────
    var typeEl = hero.querySelector('[data-hero-type]');
    if (typeEl) {
      var caption = hero.querySelector('[data-hero-caption]');
      var taglines = JSON.parse(
        (caption && caption.getAttribute('data-taglines')) || '[]'
      );
      if (!reduce && taglines.length > 0) {
        var phraseIdx = 0;
        var charIdx = 0;
        var deleting = false;
        var typeTimer = 0;
        var typeTick = function () {
          if (!hero.isConnected) return; // 换页后旧 DOM 自动停止
          var phrase = taglines[phraseIdx];
          if (!deleting) {
            charIdx++;
            typeEl.textContent = phrase.slice(0, charIdx);
            if (charIdx >= phrase.length) {
              deleting = true;
              typeTimer = setTimeout(typeTick, 2400); // 打完停留
              return;
            }
            typeTimer = setTimeout(typeTick, 90);
          } else {
            charIdx--;
            typeEl.textContent = phrase.slice(0, charIdx);
            if (charIdx <= 0) {
              deleting = false;
              phraseIdx = (phraseIdx + 1) % taglines.length;
              typeTimer = setTimeout(typeTick, 500); // 删完稍歇
              return;
            }
            typeTimer = setTimeout(typeTick, 40);
          }
        };
        typeTick();
      } else {
        // 减少动效偏好：静态显示第一条
        typeEl.textContent = taglines[0] || typeEl.textContent;
        var caret = hero.querySelector('[data-hero-caret]');
        if (reduce && caret) caret.remove();
      }
    }

    // ── 事件绑定：经 window 柄转发到最新一次初始化的闭包，
    //    避免多页导航后 document 级监听器堆积／引用旧 DOM ──
    window.__heroApi = { shuffle: shuffle, syncRipple: syncRipple };
    if (!window.__heroEventsBound) {
      window.__heroEventsBound = true;
      document.addEventListener('hero:shuffle', function () {
        window.__heroApi && window.__heroApi.shuffle();
      });
      document.addEventListener('site:settings', function () {
        window.__heroApi && window.__heroApi.syncRipple();
      });
    }

    syncRipple();
  })();
</script>
