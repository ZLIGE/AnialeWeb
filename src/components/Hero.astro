---
/**
 * 首页 Hero：顶部全宽大图轮播（Shirone 风格）。
 * - 打开网站时随机从一张图开始，之后按 hero.interval 自动轮播
 * - 指示点可手动切换；调色板「随机换一张」按钮触发 hero:shuffle 事件
 * - 底部渐变遮罩 + 站点标题（横幅标题可经面板关闭）
 * - 底部层叠波浪边界动效（面板「水波纹动画」开关控制流动/静止）
 * - 展示模式（横幅/全屏/覆盖/隐藏）由 <html data-hero-mode> 控制，见 global.css
 */
import { siteConfig } from '../config';
import Icon from './Icon.astro';

const { hero, title, subtitle, social } = siteConfig;
const images = hero.images;
const taglines = hero.taglines ?? [];
---

<section
  id="hero"
  class="relative h-[62vh] max-h-[640px] min-h-[420px] w-full overflow-hidden bg-linear-160 from-[oklch(0.3_0.08_295)] to-[oklch(0.45_0.12_320)]"
>
  {
    images.map((src, i) => (
      <img
        src={src}
        alt={`站点背景 ${i + 1}`}
        class:list={[
          'absolute inset-0 size-full object-cover transition-opacity duration-[1400ms] ease-in-out motion-reduce:transition-none',
          'opacity-0',
        ]}
        data-hero-img={i}
        loading={i === 0 ? 'eager' : 'auto'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        draggable="false"
      />
    ))
  }
  <div
    class="absolute inset-0 bg-linear-to-t from-black/60 via-black/20 to-black/25"
    style={`opacity:${hero.overlay + 0.1}`}
  >
  </div>

  <!-- 波浪边界（开关由 <html data-hero-ripple> 控制：off 时波浪静止） -->
  <div class="hero-waves" aria-hidden="true">
    <svg class="wave wave-back" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path
        d="M0,66 C240,108 480,26 720,66 C960,108 1200,26 1440,66 C1680,108 1920,26 2160,66 C2400,108 2640,26 2880,66 L2880,121 L0,121 Z"
      ></path>
    </svg>
    <svg class="wave wave-mid" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path
        d="M0,52 C240,94 480,14 720,52 C960,94 1200,14 1440,52 C1680,94 1920,14 2160,52 C2400,94 2640,14 2880,52 L2880,121 L0,121 Z"
      ></path>
    </svg>
    <svg class="wave wave-front" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path
        d="M0,34 C240,72 480,4 720,34 C960,72 1200,4 1440,34 C1680,72 1920,4 2160,34 C2400,72 2640,4 2880,34 L2880,121 L0,121 Z"
      ></path>
    </svg>
  </div>

  <!-- 标题（居中布局，横幅选项中可关闭） -->
  <div
    data-hero-caption
    data-taglines={JSON.stringify(taglines)}
    class="absolute inset-0 flex flex-col items-center justify-center gap-4 px-6 pb-10 text-center"
  >
    <h1
      class="text-4xl font-bold text-white drop-shadow-[0_2px_14px_rgba(10,5,30,0.75)] sm:text-6xl lg:text-7xl"
    >
      {title}
    </h1>
    <p class="min-h-[1.6em] text-lg text-white/90 drop-shadow sm:text-xl">
      {taglines.length > 0 ? <span data-hero-type /> : subtitle}
      {taglines.length > 0 && (
        <span class="type-caret" data-hero-caret aria-hidden="true" />
      )}
    </p>
    <div class="mt-2 flex items-center gap-2.5">
      {
        social.map((s, i) => (
          <a
            href={s.url}
            target={s.url.startsWith('/') ? undefined : '_blank'}
            rel="noopener noreferrer"
            aria-label={s.name}
            title={s.name}
            class:list={[
              'flex items-center bg-white/20 text-white backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:bg-white/35',
              i === 0
                ? 'gap-1.5 rounded-full px-4 py-2 text-sm font-medium'
                : 'size-10 justify-center rounded-full',
            ]}
          >
            <Icon name={s.icon} class="size-4.5" />
            {i === 0 && <span>{s.name}</span>}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* 打字机光标 */
  .type-caret {
    display: inline-block;
    width: 3px;
    height: 1.05em;
    margin-left: 3px;
    vertical-align: -0.12em;
    border-radius: 2px;
    background: currentColor;
    animation: hero-caret-blink 1.1s steps(2, start) infinite;
  }
  @keyframes hero-caret-blink {
    to {
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .type-caret {
      animation: none;
    }
  }

  /* 层叠波浪边界：三层不同速度/方向的波浪横向漂移（SVG 宽 200% 平移
     -50% 无缝循环），前层用页面底色与下方内容无缝衔接 */
  .hero-waves {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 130px;
    pointer-events: none;
  }
  .wave {
    position: absolute;
    /* 高度多出 20px、基线越界 10px：纵向起伏（±5~9px）在任何相位
       都不会让波浪底边升到横幅底缘之上，避免露出一条暗色间隙 */
    bottom: -10px;
    left: 0;
    width: 200%;
    height: calc(100% + 20px);
  }
  .wave-back {
    fill: rgb(255 255 255 / 0.14);
    animation: hero-wave-a 24s linear infinite reverse;
  }
  .wave-mid {
    fill: rgb(255 255 255 / 0.24);
    animation: hero-wave-b 15s linear infinite;
  }
  .wave-front {
    fill: var(--bg);
    /* 与 body 背景同时长过渡：调色板换色时波浪与下方主题色同步渐变 */
    transition: fill 0.3s ease;
    animation: hero-wave-c 10s linear infinite;
  }
  /* 多层水波动效：每层「横向漂移整周期 + 纵向起伏」，三层相位/幅度/速度
     各不相同形成层叠涌动；0% 与 100% 落点只差一个平移周期，循环无缝 */
  @keyframes hero-wave-a {
    0% {
      transform: translate3d(0, -9px, 0);
    }
    50% {
      transform: translate3d(-25%, 7px, 0);
    }
    100% {
      transform: translate3d(-50%, -9px, 0);
    }
  }
  @keyframes hero-wave-b {
    0% {
      transform: translate3d(0, 6px, 0);
    }
    50% {
      transform: translate3d(-25%, -8px, 0);
    }
    100% {
      transform: translate3d(-50%, 6px, 0);
    }
  }
  @keyframes hero-wave-c {
    0% {
      transform: translate3d(0, -5px, 0);
    }
    50% {
      transform: translate3d(-25%, 5px, 0);
    }
    100% {
      transform: translate3d(-50%, -5px, 0);
    }
  }
  /* 面板「水波纹动画」关闭时彻底去除波浪层 */
  :global([data-hero-ripple='off']) .hero-waves {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .wave {
      animation: none;
    }
  }
</style>

<!-- 随机起始 + 自动轮播 + 水波纹；data-astro-rerun 保证每次换页进入首页都重新初始化 -->
<script is:inline data-astro-rerun>
  (function () {
    var hero = document.getElementById('hero');
    if (!hero) return;
    var imgs = hero.querySelectorAll('img[data-hero-img]');
    if (imgs.length === 0) return;

    var interval = 6000;
    // 壁纸延续：优先接续本会话正在显示的那张（首页与文章横幅共享），无记录则随机
    var saved = parseInt(sessionStorage.getItem('hero-img'), 10);
    var current =
      Number.isFinite(saved) && saved >= 0 && saved < imgs.length
        ? saved
        : Math.floor(Math.random() * imgs.length);
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var timer = 0;

    function show(n) {
      current = (n + imgs.length) % imgs.length;
      imgs.forEach(function (img, i) {
        img.style.opacity = i === current ? '1' : '0';
      });
      try {
        sessionStorage.setItem('hero-img', String(current));
      } catch (e) {}
    }

    function next() {
      show(current + 1);
    }
    function restart() {
      clearInterval(timer);
      if (!reduce) {
        timer = setInterval(function () {
          // 换页后旧 DOM 已脱离文档时自动停止
          if (!hero.isConnected) {
            clearInterval(timer);
            return;
          }
          next();
        }, interval);
      }
    }

    show(current);
    restart();

    // ── 随机换一张（调色板「壁纸」段的刷新按钮） ──────────
    function shuffle() {
      if (imgs.length < 2) return;
      var n = current;
      while (n === current) n = Math.floor(Math.random() * imgs.length);
      show(n);
      restart();
    }

    // ── 打字机标语 ────────────────────────────────────────
    var typeEl = hero.querySelector('[data-hero-type]');
    if (typeEl) {
      var caption = hero.querySelector('[data-hero-caption]');
      var taglines = JSON.parse(
        (caption && caption.getAttribute('data-taglines')) || '[]'
      );
      if (!reduce && taglines.length > 0) {
        var phraseIdx = 0;
        var charIdx = 0;
        var deleting = false;
        var typeTimer = 0;
        var typeTick = function () {
          if (!hero.isConnected) return; // 换页后旧 DOM 自动停止
          var phrase = taglines[phraseIdx];
          if (!deleting) {
            charIdx++;
            typeEl.textContent = phrase.slice(0, charIdx);
            if (charIdx >= phrase.length) {
              deleting = true;
              typeTimer = setTimeout(typeTick, 2400); // 打完停留
              return;
            }
            typeTimer = setTimeout(typeTick, 90);
          } else {
            charIdx--;
            typeEl.textContent = phrase.slice(0, charIdx);
            if (charIdx <= 0) {
              deleting = false;
              phraseIdx = (phraseIdx + 1) % taglines.length;
              typeTimer = setTimeout(typeTick, 500); // 删完稍歇
              return;
            }
            typeTimer = setTimeout(typeTick, 40);
          }
        };
        typeTick();
      } else {
        // 减少动效偏好：静态显示第一条
        typeEl.textContent = taglines[0] || typeEl.textContent;
        var caret = hero.querySelector('[data-hero-caret]');
        if (reduce && caret) caret.remove();
      }
    }

    // ── 事件绑定：经 window 柄转发到最新一次初始化的闭包，
    //    避免多页导航后 document 级监听器堆积／引用旧 DOM ──
    window.__heroApi = { shuffle: shuffle };
    if (!window.__heroEventsBound) {
      window.__heroEventsBound = true;
      document.addEventListener('hero:shuffle', function () {
        window.__heroApi && window.__heroApi.shuffle();
      });
    }
  })();
</script>
