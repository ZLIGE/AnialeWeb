---
import { siteConfig } from '../config';

const { title, author, since } = siteConfig;
const year = new Date().getFullYear();
const yearRange = year > since ? `${since} - ${year}` : `${year}`;
---

<footer class="border-t border-line/60 py-6">
  <div
    class="mx-auto flex max-w-[82rem] flex-col items-center gap-1 px-4 text-center text-sm text-muted"
  >
    <p>
      © <span>{yearRange}</span>{' '}
      <a href="/" class="text-gradient font-bold">{title}</a>
      <span class="mx-1">·</span>
      <span>由 {author} 用 ❥ 搭建</span>
    </p>
    <p class="text-xs opacity-80">
      <span>Powered by</span>{' '}
      <a
        href="https://astro.build"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary">Astro</a
      >
      {' '}&amp;{' '}
      <a
        href="https://tailwindcss.com"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-primary">Tailwind CSS</a
      >
    </p>
  </div>
</footer>
