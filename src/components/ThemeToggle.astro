---
import Icon from './Icon.astro';
---

<button
  class="theme-toggle flex size-9 items-center justify-center rounded-full text-muted transition-colors hover:bg-primary/10 hover:text-primary"
  aria-label="切换明暗模式"
  title="切换明暗模式 ✧"
>
  <Icon name="sun" class="hidden size-5 dark:block" />
  <Icon name="moon" class="size-5 dark:hidden" />
</button>

<script>
  // 事件委托：绑定一次即可在视图过渡换页后继续对新的按钮生效
  document.addEventListener('click', (e) => {
    const btn =
      e.target instanceof Element ? e.target.closest('.theme-toggle') : null;
    if (!btn) return;
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* 隐私模式下忽略 */
    }
  });
</script>
