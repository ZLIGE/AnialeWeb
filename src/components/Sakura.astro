---
/**
 * 樱花飘落特效：全屏 Canvas，花瓣用贝塞尔曲线绘制（带樱瓣缺刻）。
 * 动画基于时间增量（dt）驱动，不同刷新率下速度一致；
 * 尊重系统「减少动态效果」设置；标签页隐藏时自动暂停。
 */
---

<canvas
  id="sakura-canvas"
  class="pointer-events-none fixed inset-0 z-[60] hidden"
  transition:persist="sakura"
  aria-hidden="true"
>
</canvas>

<script>
  const canvas = document.getElementById(
    'sakura-canvas'
  ) as HTMLCanvasElement | null;

  if (canvas && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      interface Petal {
        x: number;
        y: number;
        size: number;
        angle: number;
        /** 自转角速度 rad/s */
        angleVel: number;
        /** 下落速度 px/ms（约 20~48 px/s，缓缓飘落） */
        speedY: number;
        /** 水平摆幅 px */
        swayAmp: number;
        /** 摆动角速度 rad/s（约 0.5~1.2，一个来回 5~12 秒） */
        swaySpeed: number;
        phase: number;
        opacity: number;
        hue: number;
      }

      let petals: Petal[] = [];
      let width = 0;
      let height = 0;
      let rafId = 0;
      let running = false;
      let lastTime = 0;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      const spawn = (staggered: boolean): Petal => ({
        x: Math.random() * width,
        y: staggered ? Math.random() * height : -30 - Math.random() * 60,
        size: 6 + Math.random() * 8,
        angle: Math.random() * Math.PI * 2,
        angleVel: (Math.random() - 0.5) * 0.5,
        speedY: 0.02 + Math.random() * 0.028,
        swayAmp: 12 + Math.random() * 16,
        swaySpeed: 0.5 + Math.random() * 0.7,
        phase: Math.random() * Math.PI * 2,
        opacity: 0.4 + Math.random() * 0.4,
        hue: 330 + Math.random() * 18,
      });

      const resize = () => {
        width = window.innerWidth;
        height = window.innerHeight;
        canvas!.width = width * dpr;
        canvas!.height = height * dpr;
        canvas!.style.width = `${width}px`;
        canvas!.style.height = `${height}px`;
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = Math.min(26, Math.max(10, Math.floor(width / 55)));
        petals = Array.from({ length: count }, () => spawn(true));
      };

      // ── 跨页面状态续接：整页跳转后从原位置继续飘落，不重新随机 ──
      const STORE_KEY = 'sakura-state';
      const saveState = () => {
        try {
          sessionStorage.setItem(
            STORE_KEY,
            JSON.stringify({
              w: Math.round(width),
              petals: petals.map((p) => [
                Math.round(p.x),
                Math.round(p.y),
                p.size,
                Math.round(p.angle * 100) / 100,
                p.angleVel,
                p.speedY,
                p.swayAmp,
                p.swaySpeed,
                Math.round(p.phase * 100) / 100,
                p.opacity,
                p.hue,
              ]),
            })
          );
        } catch {
          /* 存储不可用时忽略 */
        }
      };
      const restoreState = (): Petal[] | null => {
        try {
          const s = JSON.parse(sessionStorage.getItem(STORE_KEY) || 'null');
          if (
            !s ||
            Math.abs((s.w || 0) - width) > 60 ||
            !Array.isArray(s.petals)
          ) {
            return null;
          }
          return s.petals.map(
            (a: number[]): Petal => ({
              x: a[0],
              y: a[1],
              size: a[2],
              angle: a[3],
              angleVel: a[4],
              speedY: a[5],
              swayAmp: a[6],
              swaySpeed: a[7],
              phase: a[8],
              opacity: a[9],
              hue: a[10],
            })
          );
        } catch {
          return null;
        }
      };

      // 樱花瓣：泪滴形 + 顶端 V 形缺刻
      const drawPetal = (p: Petal) => {
        const s = p.size;
        const sway = Math.sin(p.phase) * p.swayAmp;
        ctx!.save();
        ctx!.translate(p.x + sway, p.y);
        ctx!.rotate(p.angle + Math.sin(p.phase * 0.7) * 0.22);
        ctx!.scale(1, 0.9 + Math.sin(p.phase * 0.7) * 0.08);
        ctx!.beginPath();
        ctx!.moveTo(0, s * 0.6);
        ctx!.bezierCurveTo(s * 0.7, s * 0.35, s * 0.55, -s * 0.45, s * 0.12, -s * 0.55);
        ctx!.lineTo(0, -s * 0.36);
        ctx!.lineTo(-s * 0.12, -s * 0.55);
        ctx!.bezierCurveTo(-s * 0.55, -s * 0.45, -s * 0.7, s * 0.35, 0, s * 0.6);
        ctx!.closePath();
        ctx!.fillStyle = `hsla(${p.hue}, 85%, 82%, ${p.opacity})`;
        ctx!.fill();
        ctx!.restore();
      };

      const step = (now: number) => {
        if (!running) return;
        // 上限 48ms：切回标签页或偶发掉帧时不产生跳变
        const dt = Math.min(now - lastTime, 48);
        lastTime = now;
        // ── 每帧自检与自愈 ──
        // 画布位图尺寸被重置（视图过渡搬运元素时可能发生）则立即恢复，
        // 否则 CSS 拉伸会把花瓣放大成条纹；变换矩阵每帧重置，杜绝污染累积
        const attrW = Math.round(width * dpr);
        const attrH = Math.round(height * dpr);
        if (canvas!.width !== attrW || canvas!.height !== attrH) {
          canvas!.width = attrW;
          canvas!.height = attrH;
        }
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx!.clearRect(0, 0, width, height);
        for (const p of petals) {
          // 数据自愈：出现非有限值或异常尺寸的花瓣立即重生
          if (
            !isFinite(p.x) ||
            !isFinite(p.y) ||
            !isFinite(p.size) ||
            !isFinite(p.phase) ||
            p.size < 2 ||
            p.size > 40 ||
            p.opacity <= 0 ||
            p.opacity > 1
          ) {
            Object.assign(p, spawn(false));
          }
          p.y += p.speedY * dt;
          p.phase += (p.swaySpeed * dt) / 1000;
          p.angle += (p.angleVel * dt) / 1000;
          if (p.y > height + 30) {
            Object.assign(p, spawn(false));
          }
          drawPetal(p);
        }
        rafId = requestAnimationFrame(step);
      };

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          saveState();
          running = false;
          cancelAnimationFrame(rafId);
        } else if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          running = false;
        } else {
          running = true;
          lastTime = performance.now();
          rafId = requestAnimationFrame(step);
        }
      });

      window.addEventListener('resize', resize);
      window.addEventListener('pagehide', saveState);
      resize();
      // 同一标签页内翻页：恢复上一页的花瓣位置，视觉上无缝续接
      const restoredPetals = restoreState();
      if (restoredPetals && restoredPetals.length === petals.length) {
        petals = restoredPetals;
      }
      canvas!.classList.remove('hidden');
      running = true;
      lastTime = performance.now();
      rafId = requestAnimationFrame(step);
      // 调试句柄：便于外部验证花瓣状态
      (window as unknown as Record<string, unknown>).__sakura = petals;
    }
  }
</script>
